{
  "name": "token-engine-builder",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Builds self-contained AI agent skills for 3-tier W3C DTCG design tokens (OKLCH, WCAG + APCA, Style Dictionary v5).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "deploy": "node scripts/link-skills.mjs",
    "package": "node scripts/package-release.mjs",
    "changeset": "changeset",
    "release": "changeset version",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "node scripts/sample-css.mjs",
    "lint:skills": "node scripts/lint-skills.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run lint:skills && npm run build && npm run lint:css"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^22.0.0",
    "colorjs.io": "^0.7.1",
    "eslint": "^10.13.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "style-dictionary": "^5.7.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7"
  }
}
