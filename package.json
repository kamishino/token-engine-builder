{
  "name": "token-engine-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds self-contained AI agent skills for 3-tier W3C DTCG design tokens (OKLCH, WCAG 2.1, Style Dictionary v4).",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^22.0.0",
    "colorjs.io": "^0.7.1",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.3.0"
  }
}
