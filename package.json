{
  "name": "token-engine-builder",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Builds self-contained AI agent skills for 3-tier W3C DTCG design tokens (OKLCH, WCAG + APCA, Style Dictionary v5).",
  "license": "MIT",
  "bin": {
    "token-engine": "dist/cli/token-engine.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build-all.mjs",
    "deploy": "node --experimental-strip-types scripts/link-skills.mjs",
    "package": "node --experimental-strip-types scripts/package-release.mjs",
    "changeset": "changeset",
    "release": "changeset version",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./test/loader.mjs --test test/**/*.test.mjs",
    "lint": "eslint .",
    "lint:css": "node --experimental-strip-types scripts/sample-css.mjs",
    "lint:skills": "node --experimental-strip-types scripts/lint-skills.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run lint:skills && npm run test && npm run build && npm run lint:css",
    "smoke:contract": "node scripts/smoke-skill-contract.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "smoke": "npm run build && node scripts/smoke-all.mjs && node scripts/smoke-skill-contract.mjs && node scripts/smoke-design-tokens.mjs && node scripts/smoke-install.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^22.0.0",
    "colorjs.io": "^0.7.1",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "skills": "^1.7.4",
    "style-dictionary": "^5.7.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
