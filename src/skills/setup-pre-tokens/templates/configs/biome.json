{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "**",
      "!build",
      "!**/build",
      "!__STYLES_ROOT__/abstracts/_variables.scss",
      "!**/_variables.scss"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  }
}
