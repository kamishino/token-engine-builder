{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "token-engine/style-spec.schema.json",
  "title": "StyleSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "palette",
    "neutralHue",
    "neutralChroma",
    "typography",
    "spacingBasePx",
    "density",
    "radius",
    "targets"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "cluster": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "$description": "Optional Kobayashi style cluster id (see token-style/references/style-clusters.md)."
    },
    "palette": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "$description": "Creative palette (exactly one primary). token-math expands each anchor to a ramp keyed by name.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "anchor"],
        "properties": {
          "role": { "enum": ["primary", "secondary", "accent", "other"] },
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "anchor": { "$ref": "#/$defs/oklch" }
        }
      }
    },
    "rampSteps": { "enum": [5, 9, 11], "$description": "Ramp steps per color. Absent = 11." },
    "clusterBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h", "c", "l"],
      "properties": {
        "h": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "c": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "l": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
      }
    },
    "harmony": {
      "enum": [
        "triadic",
        "analogous",
        "complementary",
        "split-complementary",
        "tetradic",
        "monochromatic"
      ],
      "$description": "Provenance only: guidance method used when picking the palette."
    },
    "neutralHue": { "type": "number", "minimum": 0, "maximum": 360 },
    "neutralChroma": { "type": "number", "minimum": 0, "maximum": 0.05 },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "baseSizePx", "ratio"],
      "properties": {
        "fontFamily": { "type": "string", "minLength": 1 },
        "baseSizePx": { "type": "number", "exclusiveMinimum": 0 },
        "ratio": { "type": "number", "exclusiveMinimum": 1 },
        "baseLineHeight": { "type": "number", "exclusiveMinimum": 0, "maximum": 2.5 }
      }
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overview": { "type": "string" },
        "dos": { "type": "array", "items": { "type": "string" } },
        "donts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "overrides": {
      "type": "object",
      "$description": "Durable remediation: theme → semantic dotted path → alias string, applied by generate.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string", "pattern": "^\\{[a-z0-9.-]+\\}$" }
      }
    },
    "spacingBasePx": { "type": "number", "exclusiveMinimum": 0 },
    "density": { "enum": ["comfortable", "compact"] },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sm", "md", "lg", "full"],
      "properties": {
        "sm": { "type": "number", "minimum": 0 },
        "md": { "type": "number", "minimum": 0 },
        "lg": { "type": "number", "minimum": 0 },
        "full": { "type": "number", "minimum": 0 }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minWcagRatio"],
      "properties": { "minWcagRatio": { "type": "number", "minimum": 1, "maximum": 21 } }
    }
  },
  "$defs": {
    "oklch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l", "c", "h"],
      "properties": {
        "l": { "type": "number", "minimum": 0, "maximum": 1 },
        "c": { "type": "number", "minimum": 0, "maximum": 0.4 },
        "h": { "type": "number", "minimum": 0, "maximum": 360 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
