{
  "$description": "Tier 3 — button. Aliases to semantic color roles (spacing/radius alias primitives by convention).",
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.action.primary}", "$type": "color" },
      "bg-hover": { "$value": "{semantic.color.action.primary-hover}", "$type": "color" },
      "text": { "$value": "{semantic.color.action.primary-text}", "$type": "color" },
      "radius": { "$value": "{radius.md}", "$type": "dimension" },
      "padding-x": { "$value": "{spacing.4}", "$type": "dimension" },
      "padding-y": { "$value": "{spacing.2}", "$type": "dimension" },
      "font-size": { "$value": "{font-size.base}", "$type": "dimension" }
    }
  }
}
