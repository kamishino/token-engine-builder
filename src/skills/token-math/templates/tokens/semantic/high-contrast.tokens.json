{
  "$description": "Tier 2 — semantic roles, HIGH-CONTRAST theme. Same paths as light/dark; every role pushed to its strongest step. Load ONE theme per build.",
  "semantic": {
    "color": {
      "$type": "color",
      "bg": {
        "canvas": { "$value": "{color.neutral.50}" },
        "surface": { "$value": "{color.neutral.50}" },
        "subtle": { "$value": "{color.neutral.100}" },
        "raised": { "$value": "{color.brand.100}" }
      },
      "text": {
        "primary": { "$value": "{color.neutral.950}" },
        "secondary": { "$value": "{color.neutral.900}" },
        "tertiary": { "$value": "{color.neutral.800}" },
        "disabled": { "$value": "{color.neutral.600}" },
        "inverse": { "$value": "{color.neutral.50}" },
        "link": { "$value": "{color.brand.800}" }
      },
      "action": {
        "primary": { "$value": "{color.brand.800}" },
        "primary-hover": { "$value": "{color.brand.900}" },
        "primary-text": { "$value": "{color.neutral.50}" }
      },
      "border": {
        "subtle": { "$value": "{color.neutral.500}" },
        "default": { "$value": "{color.neutral.700}" },
        "strong": { "$value": "{color.neutral.900}" },
        "focus": { "$value": "{color.brand.800}" }
      },
      "feedback": {
        "success": {
          "bg": { "$value": "{color.feedback.success.100}" },
          "text": { "$value": "{color.feedback.success.900}" }
        },
        "warning": {
          "bg": { "$value": "{color.feedback.warning.100}" },
          "text": { "$value": "{color.feedback.warning.900}" }
        },
        "danger": {
          "bg": { "$value": "{color.feedback.danger.100}" },
          "text": { "$value": "{color.feedback.danger.900}" }
        },
        "info": {
          "bg": { "$value": "{color.feedback.info.100}" },
          "text": { "$value": "{color.feedback.info.900}" }
        },
        "help": {
          "bg": { "$value": "{color.feedback.help.100}" },
          "text": { "$value": "{color.feedback.help.900}" }
        }
      }
    }
  },
  "layout": {
    "$type": "dimension",
    "inset": {
      "none": { "$value": "{spacing.0}" },
      "xs": { "$value": "{spacing.1}" },
      "sm": { "$value": "{spacing.2}" },
      "base": { "$value": "{spacing.3}" },
      "md": { "$value": "{spacing.4}" },
      "lg": { "$value": "{spacing.6}" },
      "xl": { "$value": "{spacing.8}" }
    },
    "gap": {
      "tight": { "$value": "{spacing.2}" },
      "related": { "$value": "{spacing.3}" },
      "default": { "$value": "{spacing.4}" },
      "loose": { "$value": "{spacing.6}" }
    },
    "section": { "$value": "{rhythm.2}" },
    "page": { "$value": "{spacing.16}" }
  }
}
