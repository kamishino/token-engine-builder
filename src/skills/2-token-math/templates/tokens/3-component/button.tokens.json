{
  "$description": "Tier 3 — button. Aliases to semantic color roles (spacing/radius alias primitives by convention).",
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.action.primary}", "$type": "color" },
      "bgHover": { "$value": "{semantic.color.action.primaryHover}", "$type": "color" },
      "text": { "$value": "{semantic.color.action.primaryText}", "$type": "color" },
      "radius": { "$value": "{radius.md}", "$type": "dimension" },
      "paddingX": { "$value": "{spacing.4}", "$type": "dimension" },
      "paddingY": { "$value": "{spacing.2}", "$type": "dimension" },
      "fontSize": { "$value": "{fontSize.base}", "$type": "dimension" }
    }
  }
}
