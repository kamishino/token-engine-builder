{
  "$description": "Tier 1 — elevation shadows (DTCG shadow objects). Compiler emits CSS box-shadow.",
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.08 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 1, "unit": "px" },
        "blur": { "value": 2, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "md": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.12 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 12, "unit": "px" },
        "spread": { "value": -2, "unit": "px" }
      }
    },
    "lg": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.16 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 12, "unit": "px" },
        "blur": { "value": 32, "unit": "px" },
        "spread": { "value": -8, "unit": "px" }
      }
    },
    "xl": {
      "$value": {
        "color": { "colorSpace": "oklch", "components": [0.2, 0, 0], "alpha": 0.2 },
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 24, "unit": "px" },
        "blur": { "value": 48, "unit": "px" },
        "spread": { "value": -12, "unit": "px" }
      }
    }
  }
}
